{
  "name": "abc-selaras-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Pembungkus Android (Capacitor) untuk ABC Selaras",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:release": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
